# ==============================================================================
# Pdf Splitter — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and update the values to match your deployment environment:
#   cp .env.example .env
#   chmod 600 .env
#
# Pdf Splitter automatically loads these variables when running as a systemd
# service via EnvironmentFile=/opt/pdf-plitter/.env, or when exported in your shell.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP Server Settings
# ------------------------------------------------------------------------------

# Port for the web server to listen on.
# Default: 8080
PORT=8080

# Host IP to bind the web server.
# Set to '0.0.0.0' to accept connections from all interfaces.
# Set to '127.0.0.1' if running strictly behind a local reverse proxy (like Nginx).
# Default: 0.0.0.0
HOST=0.0.0.0

# Session retention duration before temporary files (uploaded PDFs, split parts,
# and ZIP archives) are automatically cleaned up from local disk.
# Format: Go duration string (e.g. 15m, 30m, 1h, 2h45m).
# Default: 15m
RETENTION=15m

# Directory for storing local session files and split parts.
# Default: ./dist/data/sessions
SESSIONS_DIR=/opt/pdf-plitter/data/sessions

# Writable config dir for the pdfcpu library (it writes its config on first use).
# Must point inside a systemd-writable path, otherwise uploads panic with
# "config problem: mkdir ...: read-only file system".
XDG_CONFIG_HOME=/opt/pdf-plitter/data/.config

# Headless mode: skip attempting to open a local desktop web browser on startup.
# Recommended: true for remote VPS / Linux servers, false for local desktop.
# Default: true
HEADLESS=true

# ------------------------------------------------------------------------------
# 2. S3-Compatible Object Storage Settings (Optional)
# ------------------------------------------------------------------------------
# If S3 credentials are provided, Pdf Splitter enables direct presigned uploads,
# remote PDF streaming, and persistent cloud storage for split parts.
# If these variables are left empty, Pdf Splitter operates in standalone mode,
# using local session disk storage (/opt/pdf-plitter/data/sessions).
# ------------------------------------------------------------------------------

# Name of the S3 bucket to store uploaded books and split output parts.
# Example: my-school-books
S3_BUCKET=

# AWS Region where the bucket is located.
# AWS Examples: us-east-1, eu-west-1, ap-southeast-1
# Cloudflare R2: auto
# MinIO: us-east-1 (or whatever is configured on MinIO)
# Default: us-east-1
S3_REGION=us-east-1

# S3 Access Key ID (API Key / Client ID)
S3_ACCESS_KEY_ID=

# S3 Secret Access Key (API Secret)
S3_SECRET_ACCESS_KEY=

# Custom S3 Endpoint URL (Required for MinIO, Cloudflare R2, Wasabi, Ceph).
# Leave completely blank if using standard AWS S3.
# Examples:
#   Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   MinIO (Local): http://127.0.0.1:9000
#   Wasabi (EU):   https://s3.eu-central-1.wasabisys.com
S3_ENDPOINT=

# Force Path Style addressing (http://endpoint/bucket/key vs virtual-host http://bucket.endpoint/key).
# Set to 'true' for MinIO and older S3-compatible systems.
# Set to 'false' for AWS S3 and Cloudflare R2.
# Default: false
S3_FORCE_PATH_STYLE=false

# Use SSL/TLS for S3 connections.
# Set to 'true' for HTTPS (AWS S3, Cloudflare R2, Wasabi, production MinIO).
# Set to 'false' only for local non-SSL development MinIO (http://).
# Default: true
S3_USE_SSL=true

# ------------------------------------------------------------------------------
# Example Preset Configurations
# ------------------------------------------------------------------------------
# AWS S3:
#   S3_BUCKET=my-production-pdf-plitter
#   S3_REGION=us-east-1
#   S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
#   S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#   S3_ENDPOINT=
#   S3_FORCE_PATH_STYLE=false
#   S3_USE_SSL=true
#
# Cloudflare R2:
#   S3_BUCKET=pdf-plitter-r2
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID=cf7a6e9...
#   S3_SECRET_ACCESS_KEY=4a1b2c3d4e5f...
#   S3_ENDPOINT=https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_FORCE_PATH_STYLE=false
#   S3_USE_SSL=true
#
# Local / Self-Hosted MinIO:
#   S3_BUCKET=pdf-plitter
#   S3_REGION=us-east-1
#   S3_ACCESS_KEY_ID=minioadmin
#   S3_SECRET_ACCESS_KEY=minioadmin
#   S3_ENDPOINT=http://127.0.0.1:9000
#   S3_FORCE_PATH_STYLE=true
#   S3_USE_SSL=false
# ==============================================================================
