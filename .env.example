# ==============================================================================
# PDF Splitter — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and update the values to match your deployment:
#   cp .env.example .env
#   chmod 600 .env
#
# Loaded automatically by systemd via EnvironmentFile=-/opt/pdf-splitter/.env
# Note: pdfcpu runs in stateless mode in code, so XDG_CONFIG_HOME is not required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP Server Settings
# ------------------------------------------------------------------------------

# Port for the web server to listen on.
# Default: 8080
PORT=8080

# Host IP to bind the web server.
# Keep '127.0.0.1' when running behind Cloudflare Tunnel or Nginx (recommended).
# Set to '0.0.0.0' only if you intentionally expose the Go server directly.
# Default: 127.0.0.1
HOST=127.0.0.1

# Session retention duration before temporary files (uploaded PDFs, split parts,
# and ZIP archives) are automatically cleaned up from local disk and S3.
# Format: Go duration string (e.g. 15m, 30m, 1h, 2h45m).
# Default: 15m
RETENTION=15m

# Maximum allowed PDF upload size in megabytes (enforced both client-side and server-side).
# - Behind Cloudflare Tunnel (Free/Pro) without S3: set to 100 so the UI warns before
#   Cloudflare's 100 MB edge limit rejects the request with HTTP 413.
# - With S3/R2 direct uploads enabled (or direct Nginx): up to 500.
# Default: 100 (safe for Cloudflare Tunnel); raise to 500 when S3 or Nginx-only is used.
MAX_UPLOAD_MB=100

# Public releases page the frontend "Download App" buttons link to.
# Release assets are built and published by GitHub Actions on version tags (v*).
# Default: https://github.com/metacrafts-dev/pdf-splitter/releases/latest
RELEASES_URL=https://github.com/metacrafts-dev/pdf-splitter/releases/latest

# Directory for storing local session files and split parts.
# Defaults to ./data/sessions next to the binary (/opt/pdf-splitter/data/sessions on VPS),
# which is inside ReadWritePaths=/opt/pdf-splitter/data under systemd ProtectSystem=strict.
SESSIONS_DIR=/opt/pdf-splitter/data/sessions

# Writable config dir for the pdfcpu library (it writes its config on first use).
# Must point inside a systemd-writable path, otherwise uploads panic with
# "config problem: mkdir ...: read-only file system".
XDG_CONFIG_HOME=/opt/pdf-plitter/data/.config

# Headless mode: skip attempting to open a local desktop web browser on startup.
# Recommended: true for remote VPS / Linux servers, false for local desktop.
# Default: true (for VPS deployments)
HEADLESS=true

# ------------------------------------------------------------------------------
# 2. S3-Compatible Object Storage Settings (Optional)
# ------------------------------------------------------------------------------
# If S3 credentials are provided, PDF Splitter enables direct presigned uploads
# (bypassing Cloudflare's 100 MB body cap) and periodic TTL cleanup in S3/R2.
# If left empty, PDF Splitter uses local session disk storage.
# ------------------------------------------------------------------------------

S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Custom S3 Endpoint URL (Required for MinIO, Cloudflare R2, Wasabi, Ceph).
# Leave blank for standard AWS S3.
#   Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   MinIO (Local): http://127.0.0.1:9000
#   Wasabi (EU):   https://s3.eu-central-1.wasabisys.com
S3_ENDPOINT=

# Set to 'true' for MinIO / LocalStack; 'false' for AWS S3 and Cloudflare R2.
S3_FORCE_PATH_STYLE=false

# Set to 'false' only for local non-SSL development MinIO (http://).
S3_USE_SSL=true
