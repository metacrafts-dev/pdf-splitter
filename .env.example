# ==============================================================================
# PDF Splitter — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and update the values to match your deployment:
#   cp .env.example .env
#   chmod 600 .env
#
# Loaded automatically by systemd via EnvironmentFile=/opt/pdf-splitter/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP Server Settings
# ------------------------------------------------------------------------------

# Port for the web server to listen on.
# Default: 8080
PORT=8080

# Host IP to bind the web server.
# Keep '127.0.0.1' when running behind Nginx or Cloudflare Tunnel (recommended).
# Set to '0.0.0.0' only if you intentionally expose the Go server directly.
# Default: 127.0.0.1 (for VPS deployments)
HOST=127.0.0.1

# Session retention duration before temporary files (uploaded PDFs, split parts,
# and ZIP archives) are automatically cleaned up from local disk and S3.
# Format: Go duration string (e.g. 15m, 30m, 1h, 2h45m).
# Default: 15m
RETENTION=15m

# Maximum allowed PDF upload size in megabytes.
# Note: Cloudflare Free/Pro plans enforce a 100 MB HTTP body limit for proxied
# traffic; configure S3 storage below for direct browser uploads above 100 MB.
# Default: 500
MAX_UPLOAD_MB=500

# Directory for storing local session files and split parts.
# Must be inside a ReadWritePaths directory when running under systemd ProtectSystem=strict.
# Default: ./dist/data/sessions
SESSIONS_DIR=/opt/pdf-splitter/data/sessions

# Headless mode: skip attempting to open a local desktop web browser on startup.
# Recommended: true for remote VPS / Linux servers, false for local desktop.
# Default: true (for VPS deployments)
HEADLESS=true

# ------------------------------------------------------------------------------
# 2. S3-Compatible Object Storage Settings (Optional)
# ------------------------------------------------------------------------------
# If S3 credentials are provided, PDF Splitter enables direct presigned uploads,
# remote PDF streaming, and cloud storage for split parts with periodic TTL cleanup.
# If left empty, PDF Splitter uses local session disk storage.
# ------------------------------------------------------------------------------

S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Custom S3 Endpoint URL (Required for MinIO, Cloudflare R2, Wasabi, Ceph).
# Leave blank for standard AWS S3.
#   Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   MinIO (Local): http://127.0.0.1:9000
#   Wasabi (EU):   https://s3.eu-central-1.wasabisys.com
S3_ENDPOINT=

# Set to 'true' for MinIO / LocalStack; 'false' for AWS S3 and Cloudflare R2.
S3_FORCE_PATH_STYLE=false

# Set to 'false' only for local non-SSL development MinIO (http://).
S3_USE_SSL=true
